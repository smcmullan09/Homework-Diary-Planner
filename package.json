{
  "name": "smm-homework-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "build:postgres": "prisma generate --schema prisma/postgres/schema.prisma && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json *.md deployment/*.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:owner": "tsx scripts/owner.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "test:integration": "tsx scripts/integration.ts",
    "db:postgres": "tsx scripts/postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.0",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
